# Copia este archivo como .env (local) y define las mismas variables en
# Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave pública (publishable / anon). NUNCA pongas aquí la service_role/secret.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo la Consola (apps/consola): dominio de la app de tiendas, para armar el
# link de cada empresa (https://<dominio>/e/<código>) y su QR.
VITE_TIENDAS_URL=https://tu-app-de-tiendas.vercel.app

# Solo tiendas (apps/tiendas): dominio de la Consola Operalia, para el aviso de
# /plataforma y el link del superadmin en el menú.
VITE_CONSOLA_URL=https://tu-consola.vercel.app

# El correo interno de Auth es usuario@<código de empresa>.operalia.local
# (migración 0022). Ya no hay variable para el dominio.
