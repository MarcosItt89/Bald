# Copia este archivo como .env (local) y define las mismas variables en
# Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave pública (publishable / anon). NUNCA pongas aquí la service_role/secret.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Dominio interno para convertir usuario → correo de Supabase Auth
# (debe coincidir con el usado en supabase/seed/0009_usuarios_y_demo.sql)
VITE_AUTH_EMAIL_DOMAIN=operalia.local
