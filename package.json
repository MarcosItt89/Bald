{
  "name": "operalia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @operalia/tiendas",
    "dev:consola": "npm run dev -w @operalia/consola",
    "build": "npm run build -w @operalia/tiendas && npm run build -w @operalia/consola",
    "build:tiendas": "npm run build -w @operalia/tiendas",
    "build:consola": "npm run build -w @operalia/consola",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0"
  }
}
